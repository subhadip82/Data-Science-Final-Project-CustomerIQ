# CustomerIQ Environment Variables
# Copy this to .env and fill in your values

# ─── Clerk Authentication ─────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT configuration (for backend JWT verification)
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (sync for Alembic, async for app)
DATABASE_URL=postgresql+asyncpg://customeriq:customeriq@localhost:5432/customeriq

# ─── Backend ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_SIZE_MB=50
APP_NAME=CustomerIQ API
APP_VERSION=1.0.0
DEBUG=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/app
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/app
